[user]
	email = miguelvps@gmail.com
	name = Miguel Serrano
[core]
	editor = vim
	excludesfile = ~/.gitglobalignore
[pull]
	ff = only
[merge]
	tool = vimdiff
[rebase]
	autostash = true
[color]
	ui = auto
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
